# Copy to deploy/.env (git-ignored) and fill in. Read by brain/app/core/config.py and docker compose.
# Full table: docs/ENVIRONMENT.md §3.1. Values below work for the laptop dev stack.

ENV=dev
# Google only accepts http://localhost redirects in testing mode, so keep localhost here.
PUBLIC_URL=http://localhost:8080
DATABASE_URL=postgresql+asyncpg://spark:spark@127.0.0.1:5432/spark
REDIS_URL=redis://127.0.0.1:6379/0
SEARXNG_URL=http://127.0.0.1:8888

# 64+ random bytes, e.g. python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=
JWT_SECRET_PREVIOUS=
# 32 bytes, base64. Encrypts BYOK + OAuth tokens (used from R4). Losing it orphans them.
ENCRYPTION_MASTER_KEY=

# Comma-separated app origins. Never "*".
CORS_ORIGINS=http://localhost:5123
PAID_PROVIDERS_ENABLED=false
ALLOW_TRAINING_PROVIDERS_DEFAULT=false

# OTP email (Resend free plan). Without a verified domain Resend only delivers to your own address.
RESEND_API_KEY=
MAIL_FROM=Spark <onboarding@resend.dev>

# Google sign-in. Authorized redirect URI: {PUBLIC_URL}/v2/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Compose only
POSTGRES_PASSWORD=spark
SEARXNG_SECRET=

# R1+ (free chains)
GROQ_API_KEYS=
NVIDIA_API_KEYS=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKENS=
MISTRAL_API_KEYS=
GEMINI_API_KEYS=
OPENROUTER_API_KEYS=
